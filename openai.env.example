# Copy to openai.env at the repo root (gitignored; chmod 600), uncomment
# and fill in the keys you use, then `source openai.env` (see the README).
# Code that reads it directly (the SkillOpt adapters) honours
# DSKILL_ENV_FILE as an override path. Explicit OPENAI_BASE_URL overrides
# the auto-detection.
export OPENAI_API_KEY=sk-REPLACE_ME
# export OPENAI_BASE_URL=https://api.openai.com/v1

# --- LLM provider switch -------------------------------------------
# openai (default) | openrouter. OpenRouter is OpenAI-compatible; bare
# model names get prefixed with HD_OPENROUTER_PREFIX (default openai/)
# at request time only — run dirs keep the bare local names.
export HD_PROVIDER=openai
# export OPENROUTER_API_KEY=REPLACE_WITH_OPENROUTER_KEY
# export HD_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# export HD_OPENROUTER_PREFIX=openai/

# --- other keys ------------------------------------------------------
# TINKER_API_KEY: SFT (dskill.sft.train) and tinker_proxy.
# export TINKER_API_KEY=REPLACE_WITH_TINKER_KEY
# WANDB_API_KEY: optional experiment logging.
# export WANDB_API_KEY=REPLACE_WITH_WANDB_KEY
